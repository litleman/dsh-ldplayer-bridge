{
  "name": "advisor-toggle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "顾问开关：方案与交付先交给 ChatGPT 顾问评审，拿到 GO 才继续；HOLD 补资料、NO-GO 改方案。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./config": "./config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "config.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "scripts/*.mjs",
    "tools/*.mjs",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
